<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lumora" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/lumora_blue</item>
        <item name="android:statusBarColor">@color/lumora_night</item>
        <item name="android:navigationBarColor">@color/lumora_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/lumora_night</item>
    </style>
    <style name="Theme.Lumora.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lumora_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_lumora_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumora</item>
    </style>
</resources>
